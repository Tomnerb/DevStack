#!/bin/sh
set -eu

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
mkdir -p /dev/pts /run /run/lock /sys/fs/cgroup /var/lib/containerd
mount -t devpts devpts /dev/pts 2>/dev/null || true
mount -t tmpfs tmpfs /run 2>/dev/null || true
mount -t cgroup2 none /sys/fs/cgroup 2>/dev/null || true
mkdir -p /run/containerd /run/lock

hostname dockiva-macos

mkdir -p /mnt/dockiva/host
mount -t virtiofs dockiva /mnt/dockiva/host 2>/dev/null || true

ip link set lo up 2>/dev/null || true

if ip link show eth0 >/dev/null 2>&1; then
  ip link set eth0 up || true
  udhcpc -i eth0 -q -n -t 10 || true
fi

cat >/etc/resolv.conf <<'EOF'
nameserver 1.1.1.1
nameserver 8.8.8.8
EOF

mkdir -p /etc/containerd
mkdir -p /etc/docker /var/lib/docker /var/run/docker

cat >/etc/containerd/config.toml <<'EOF'
version = 3
root = "/var/lib/containerd"
state = "/run/containerd"

[grpc]
  address = "/run/containerd/containerd.sock"

[plugins.'io.containerd.cri.v1.runtime'.containerd]
  default_runtime_name = "runc"
EOF

echo "dockiva-init: starting containerd"

/usr/local/bin/containerd \
  --config /etc/containerd/config.toml \
  >/var/log/containerd.log 2>&1 &

for _ in $(seq 1 100); do
  if [ -S /run/containerd/containerd.sock ]; then
    break
  fi
  sleep 0.1
done

if [ ! -S /run/containerd/containerd.sock ]; then
  echo "dockiva-init: containerd socket did not appear"
  cat /var/log/containerd.log 2>/dev/null || true
  exec sh
fi

cat >/etc/docker/daemon.json <<'EOF'
{
  "data-root": "/var/lib/docker",
  "exec-root": "/var/run/docker",
  "hosts": ["unix:///run/docker.sock"],
  "iptables": false,
  "ip6tables": false,
  "userland-proxy": false
}
EOF

echo "dockiva-init: starting Docker Engine"
/usr/local/bin/dockerd --config-file /etc/docker/daemon.json >/var/log/dockerd.log 2>&1 &

for _ in $(seq 1 100); do
  [ -S /run/docker.sock ] && break
  sleep 0.1
done

if [ ! -S /run/docker.sock ]; then
  echo "dockiva-init: Docker socket did not appear"
  cat /var/log/dockerd.log 2>/dev/null || true
  exec sh
fi

echo "dockiva-init: starting vsock proxy"

/usr/local/bin/dockiva-guestd \
  --port 10250 \
  --target /run/containerd/containerd.sock \
  >/var/log/dockiva-guestd.log 2>&1 &

/usr/local/bin/dockiva-guestd \
  --port 10251 \
  --target /run/docker.sock \
  >/var/log/dockiva-dockerd-proxy.log 2>&1 &

echo "dockiva-init: ready"

while true; do
  sleep 3600
done
